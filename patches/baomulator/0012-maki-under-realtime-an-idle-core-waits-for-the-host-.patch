+    /// `--realtime` holds it just ahead of the host's clock, so an asleep core waits for the
+    /// clock, and for the host's input, rather than leaping to its next timer.
+    pub idle_limit_ns: u64,
 }
 
 impl Machine {
@@ -69,6 +73,7 @@ impl Machine {
             code_gen: 1,
             code_pg: vec![0u8; CODE_PG_LEN].into_boxed_slice(),
             code_inval: 0,
+            idle_limit_ns: u64::MAX,
         };
         // Baochip-1x memory regions (utralib/src/generated/bao1x.rs)
         mach.add_region(0x5000_0000, 0x20000, true); // IFRAM0 (128 KiB)
@@ -432,6 +437,12 @@ impl Machine {
         self.soc.irq_invalidate();
     }
 
+    /// maki: how far an idle core may still skip (see `idle_limit_ns`); 0 = it must stop here.
+    #[inline]
+    pub fn idle_room(&self) -> u64 {
+        self.idle_limit_ns.saturating_sub(self.time_ns())
+    }
+
     /// Current virtual time in microseconds (CSR `time` reads).
     pub fn time(&self) -> u64 {
         self.time_ns() / 1000
diff --git a/src/cpu.rs b/src/cpu.rs
index 244c05b..0f81a2e 100644
--- a/src/cpu.rs
+++ b/src/cpu.rs
@@ -913,15 +913,23 @@ impl Cpu {
                     // time can wake the core — only host input or an MMIO write
                     // can. Fall back to the old quantum there; it is bounded
                     // work, and the browser paces wall-clock time separately.
+                    //
+                    // maki: and never past `idle_limit_ns`. There the slice ends with
+                    // `asleep` = 2, so the caller can wait for its clock or its input.
+                    let room = mach.idle_room();
+                    if room == 0 {
+                        asleep = 2;
+                        break;
+                    }
                     let dt = mach.next_irq_dt();
                     self.instret += 1;
                     n += 1;
                     asleep = 1;
                     if dt == u64::MAX {
-                        mach.tick(ns * 2048);
+                        mach.tick((ns * 2048).min(room));
                         continue;
                     }
-                    mach.tick(dt.max(ns));
+                    mach.tick(dt.max(ns).min(room));
                     break;
                 }
                 self.wfi = false;
diff --git a/src/lib.rs b/src/lib.rs
index 2c6649c..804afcc 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -381,6 +381,11 @@ pub extern "C" fn emu_run(e: *mut Emulator, max_insns: u32, ns_per_insn: u32) ->
             let (n, a) = e.cpu.run_slice(&mut e.mach, mip, budget, ns);

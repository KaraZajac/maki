 src/bin/shot.rs | 26 ++++++++++++++++++++++----
 src/bus.rs      | 11 +++++++++++
 src/cpu.rs      | 12 ++++++++++--
 src/lib.rs      | 20 ++++++++++++++++++--
 4 files changed, 61 insertions(+), 8 deletions(-)

diff --git a/src/bin/shot.rs b/src/bin/shot.rs
index d58936c..3ecfdc4 100644
--- a/src/bin/shot.rs
+++ b/src/bin/shot.rs
@@ -55,8 +55,10 @@
 //!                     for L), `shot NAME`
 //!                     (the screen into OUT/NAME.pgm), `screen` (it as text, then "end") and
 //!                     `quit`
-//!   --realtime        never let maki's time run ahead of this computer's: it waits rather than
-//!                     skipping idle time, so a host's timing (heartbeats, timeouts) holds
+//!   --realtime        never let maki's time run ahead of this computer's: asleep, it waits
+//!                     for the clock (and wakes for the host's bytes) rather than skipping to
+//!                     its next timer, so a host's timing (heartbeats, timeouts) holds. Counts
+//!                     (presses, answers, profiles) are then of time: 10 ns each
 //!   --realtime-from T from instruction count T on (once maki's booted and its PIN's in, say):
 //!                     before then, as fast as it goes
 //!   --console-live    print maki's console as it comes, a line at a time
@@ -815,6 +817,10 @@ fn main() {
     let mut paced: Option<(std::time::Instant, u64)> = None;
     // Run in slices so virtual time advances the same way as the web UI does.
     const SLICE: u64 = 10_000_000;
+    const NS_PER_INSN: u64 = 10;
+    // `--realtime`: how far an asleep maki may run ahead of this computer's clock, which is
+    // about how long the loop below sleeps at a time while it waits
+    const IDLE_AHEAD_NS: u64 = 4_000_000;
     let mut samples = String::new();
     a.rpt.sort();
     let mut rpts = a.rpt.clone().into_iter();
@@ -829,8 +835,20 @@ fn main() {
                 .min(next_sample.saturating_sub(total).max(1))
                 .min(rpt_at.saturating_sub(total).max(1))
                 .min(profile.as_ref().map_or(u64::MAX, |p| p.2.saturating_sub(total).max(1)));
-            baomulator::emu_run(e, chunk as u32, 10);
-            total += chunk;
+            // `--realtime`: an asleep maki skips no further than this computer's clock (nor past
+            // this slice), so the host's bytes reach it as they come, as a badge's USB interrupt
+            // would wake it, rather than once its next timer is due; the slice then counts the
+            // time it took rather than its budget
+            let start = baomulator::emu_time_ns(e);
+            if let Some((wall, emu)) = paced {
+                let now = emu + wall.elapsed().as_nanos() as u64 + IDLE_AHEAD_NS;
+                baomulator::emu_set_idle_limit(e, now.min(start + chunk * NS_PER_INSN));
+            }
+            baomulator::emu_run(e, chunk as u32, NS_PER_INSN as u32);
+            total += match paced {
+                Some(_) => (baomulator::emu_time_ns(e) - start) / NS_PER_INSN,
+                None => chunk,
+            };
             if let Some(pipe) = usb.as_mut() {
                 pipe.pump(e, total);
             }
diff --git a/src/bus.rs b/src/bus.rs

         e.dump_kick1();
@@ -423,9 +428,13 @@ pub extern "C" fn emu_run(e: *mut Emulator, max_insns: u32, ns_per_insn: u32) ->
             }
         }
         if was_wfi && e.cpu.wfi {
-            // stayed asleep: fast-forward virtual time
-            e.mach.tick(ns_per_insn as u64 * 2048);
+            // stayed asleep: fast-forward virtual time (maki: no further than `idle_limit_ns`)
+            let room = e.mach.idle_room();
             asleep = 1;
+            if room == 0 {
+                break;
+            }
+            e.mach.tick((ns_per_insn as u64 * 2048).min(room));
         } else {
             e.mach.tick(ns_per_insn as u64);
             asleep = 0;
@@ -486,6 +495,13 @@ pub extern "C" fn emu_time_ns(e: *mut Emulator) -> u64 {
     unsafe { &mut *e }.mach.time_ns()
 }
 
+/// maki: an idle core skips no further than `ns` of virtual time, and `emu_run` returns there
+/// (`u64::MAX`, the default: no bound). For pacing to a host clock: see shot's `--realtime`.
+#[no_mangle]
+pub extern "C" fn emu_set_idle_limit(e: *mut Emulator, ns: u64) {
+    unsafe { &mut *e }.mach.idle_limit_ns = ns;
+}

@@ -5,14 +5,46 @@
 //!   STATUS reads 0 (success)
 //! - EPRUNNING @0x464 = 0, PORTSC @0x430 = 0 (no connection)
 //! - all other registers read-as-written
+//!
+//! maki: and a paravirtual pipe at PIPE_BASE (0x5020_4F00), the last of the registers usb-bao1x
+//! maps (from 0x5020_2000), where the real controller has nothing. maki's USB service built for
+//! the emulator (MAKI_EMU_USB) carries its serial port, FIDO reports and keystrokes through it
+//! instead of the controller, and `shot --usb PORT` joins each channel to a TCP stream on the
+//! host, so maki desktop and test clients reach the emulated maki as they would a real one.
+//!
+//! - +0x00 MAGIC reads "maki" (little-endian), so the service can tell it's there
+//! - channel c (0 serial, 1 FIDO, 2 keyboard) at +0x10 + 0x10*c: +0x0 TX (write: a byte out),
+//!   +0x8 RXAVAIL (read: bytes waiting), +0xC RX (read: the next byte, 0 if none)
+
+use std::collections::VecDeque;
+
+pub const PIPE_BASE: u32 = 0x5020_4F00;
+pub const PIPE_LEN: u32 = 0x100;
+pub const PIPE_MAGIC: u32 = u32::from_le_bytes(*b"maki");
+pub const PIPE_CHANNELS: usize = 3;
+/// What a channel keeps for a host that isn't reading, at most: older bytes go.
+const PIPE_KEEP: usize = 1 << 20;
 
 pub struct Udc {
     regs: Vec<u32>, // 0x5020_0000 .. 0x5021_0000
+    /// bytes from the host, for the firmware to read, per channel
+    pub pipe_rx: [VecDeque<u8>; PIPE_CHANNELS],
+    /// bytes the firmware wrote, for the host, per channel
+    pub pipe_tx: [VecDeque<u8>; PIPE_CHANNELS],
+}
+
+fn pipe_channel(off: u32) -> Option<(usize, u32)> {
+    let c = off.checked_sub(0x10)? / 0x10;
+    ((c as usize) < PIPE_CHANNELS).then(|| (c as usize, (off - 0x10) % 0x10))
 }
 
 impl Udc {
     pub fn new() -> Udc {
-        Udc { regs: vec![0; 0x1000 / 4] }
+        Udc {
+            regs: vec![0; 0x1000 / 4],
+            pipe_rx: Default::default(),
+            pipe_tx: Default::default(),
+        }
     }
 
     pub fn read(&mut self, off: u32) -> u32 {
@@ -30,6 +62,28 @@ impl Udc {
         }
     }
 
+    /// The pipe's registers, `off` from PIPE_BASE.
+    pub fn pipe_read(&mut self, off: u32) -> u32 {
+        if off == 0 {
+            return PIPE_MAGIC;
+        }
+        match pipe_channel(off) {
+            Some((c, 0x8)) => self.pipe_rx[c].len().min(u32::MAX as usize) as u32,
+            Some((c, 0xC)) => self.pipe_rx[c].pop_front().unwrap_or(0) as u32,
+            _ => 0,
+        }
+    }
+
+    pub fn pipe_write(&mut self, off: u32, val: u32) {
+        if let Some((c, 0x0)) = pipe_channel(off) {
+            let tx = &mut self.pipe_tx[c];
+            if tx.len() >= PIPE_KEEP {
+                tx.pop_front();
+            }
+            tx.push_back(val as u8);
+        }
+    }
+

+/// maki: `--usb`: the pipe's channels (0 serial, 1 FIDO, 2 keyboard) as TCP servers, a client
+/// each, and what's waiting to go to each client.
+struct UsbPipe {
+    listeners: Vec<std::net::TcpListener>,
+    clients: Vec<Option<std::net::TcpStream>>,
+    pending: Vec<Vec<u8>>,
+    /// the keys down, for printing what's typed
+    keys: Vec<u8>,
+    typed: String,
+}
+
+const PIPE_NAMES: [&str; 3] = ["serial", "FIDO", "keyboard"];
+
+impl UsbPipe {
+    fn bind(port: u16) -> std::io::Result<UsbPipe> {
+        let mut listeners = Vec::new();
+        for c in 0..3u16 {
+            let l = std::net::TcpListener::bind(("127.0.0.1", port + c))?;
+            l.set_nonblocking(true)?;
+            listeners.push(l);
+        }
+        Ok(UsbPipe {
+            listeners,
+            clients: vec![None, None, None],
+            pending: vec![Vec::new(), Vec::new(), Vec::new()],
+            keys: Vec::new(),
+            typed: String::new(),
+        })
+    }
+
+    /// Move what's waiting each way. Bytes for a channel nobody's connected to are dropped, as
+    /// USB with no host would.
+    fn pump(&mut self, e: *mut Emulator, total: u64) {
+        use std::io::{ErrorKind, Read, Write};
+        for c in 0..3 {
+            if self.clients[c].is_none() {
+                if let Ok((stream, peer)) = self.listeners[c].accept() {
+                    stream.set_nonblocking(true).ok();
+                    stream.set_nodelay(true).ok();
+                    println!("[{total:>13}] usb: {} connected from {peer}", PIPE_NAMES[c]);
+                    self.clients[c] = Some(stream);
+                    self.pending[c].clear();
+                }
+            }
+            let out = baomulator::emu_pipe_take(e, c);
+            if c == 2 {
+                self.typing(&out, total);
+            }
+            let Some(stream) = self.clients[c].as_mut() else { continue };
+            let mut gone = false;
+            let mut buf = [0u8; 4096];
+            loop {
+                match stream.read(&mut buf) {
+                    Ok(0) => {
+                        gone = true;
+                        break;
+                    }
+                    Ok(n) => baomulator::emu_pipe_give(e, c, &buf[..n]),
+                    Err(err) if err.kind() == ErrorKind::WouldBlock => break,
+                    Err(err) if err.kind() == ErrorKind::Interrupted => continue,
+                    Err(_) => {
+                        gone = true;
+                        break;
+                    }
+                }
+            }
+            self.pending[c].extend_from_slice(&out);
+            while !gone && !self.pending[c].is_empty() {
+                match stream.write(&self.pending[c]) {
+                    Ok(n) => {
+                        self.pending[c].drain(..n);
+                    }
+                    Err(err) if err.kind() == ErrorKind::WouldBlock => break,
+                    Err(err) if err.kind() == ErrorKind::Interrupted => continue,
+                    Err(_) => gone = true,
+                }
+            }
+            if gone {
+                println!("[{total:>13}] usb: {} disconnected", PIPE_NAMES[c]);
+                self.clients[c] = None;
+                self.pending[c].clear();
+            }
+        }
+    }
+
+    /// Keystrokes as text: each key pressed, shifted or not, once all keys are up again.
+    fn typing(&mut self, codes: &[u8], total: u64) {
+        for &code in codes {
+            if code != 0 {
+                self.keys.push(code);
+                continue;
+            }
+            let shift = self.keys.iter().any(|&k| k == 0xe1 || k == 0xe5);
+            for &k in &self.keys {
+                if let Some(text) = usage_text(k, shift) {
+                    self.typed.push_str(&text);
+                }
+            }
+            self.keys.clear();
+        }
+        if !self.typed.is_empty() && self.keys.is_empty() {
+            println!("[{total:>13}] usb: typed {:?}", self.typed);
+            self.typed.clear();
+        }
+    }
+}
+
+/// A HID keyboard usage as text (US layout), or a name in brackets for keys that aren't text.
+fn usage_text(code: u8, shift: bool) -> Option<String> {
+    const LOWER: &[u8] = b"abcdefghijklmnopqrstuvwxyz1234567890";
+    const UPPER: &[u8] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%^&*()";
+    const PUNCT: [(u8, char, char); 11] = [
+        (0x2d, '-', '_'),
+        (0x2e, '=', '+'),
+        (0x2f, '[', '{'),
+        (0x30, ']', '}'),
+        (0x31, '\\', '|'),
+        (0x33, ';', ':'),
+        (0x34, '\'', '"'),
+        (0x35, '`', '~'),
+        (0x36, ',', '<'),
+        (0x37, '.', '>'),
+        (0x38, '/', '?'),
+    ];
+    Some(match code {
+        0x04..=0x27 => {
+            let i = (code - 0x04) as usize;
+            ((if shift { UPPER } else { LOWER })[i] as char).to_string()
+        }
+        0x28 => "\n".into(),
+        0x29 => "[Esc]".into(),
+        0x2a => "[Backspace]".into(),
+        0x2b => "\t".into(),
+        0x2c => " ".into(),
+        0x3a..=0x45 => format!("[F{}]", code - 0x39),
+        0x4b => "[PageUp]".into(),
+        0x4e => "[PageDown]".into(),
+        0x4f => "[Right]".into(),
+        0x50 => "[Left]".into(),
+        0x51 => "[Down]".into(),
+        0x52 => "[Up]".into(),
+        0xe0..=0xe7 => return None,
+        _ => match PUNCT.iter().find(|(c, _, _)| *c == code) {
+            Some((_, plain, shifted)) => (if shift { *shifted } else { *plain }).to_string(),
+            None => format!("[{code:#04x}]"),
+        },
+    })
 }
 

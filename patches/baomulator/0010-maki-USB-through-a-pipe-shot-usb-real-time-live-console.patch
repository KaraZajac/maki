+/// maki: what maki's USB service has written on pipe channel `chan` (0 serial, 1 FIDO, 2
+/// keyboard) since the last call. See `bus::devices::udc`.
+pub fn emu_pipe_take(e: *mut Emulator, chan: usize) -> Vec<u8> {
+    let e = unsafe { &mut *e };
+    e.mach.soc.udc.pipe_tx.get_mut(chan).map(|q| q.drain(..).collect()).unwrap_or_default()
+}
+
+/// maki: bytes for maki's USB service to read on pipe channel `chan`.
+pub fn emu_pipe_give(e: *mut Emulator, chan: usize, data: &[u8]) {
+    let e = unsafe { &mut *e };
+    if let Some(q) = e.mach.soc.udc.pipe_rx.get_mut(chan) {
+        q.extend(data);
+    }
+}

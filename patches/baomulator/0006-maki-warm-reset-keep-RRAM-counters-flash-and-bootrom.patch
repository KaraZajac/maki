+/// Warm reset, the way pulling and re-plugging the badge would: the CPU restarts at boot0
+/// (0x6000_0000), volatile RAM (SRAM, IFRAM, AORAM) is cleared and the device fabric is rebuilt,
+/// but the non-volatile state a real chip keeps is preserved — the RRAM array (0x6000_0000, which
+/// holds the boot stages, the loader and the key/data slots), the one-way counters, the IFR fuse
+/// block, and the external SPI flash (swap and the PDDB, at 0x7000_0000). Volatile device state
+/// (timers, UDMA, the OLED controller) is rebuilt.
+///
+/// This is what lets the two-boot parts of the trust chain be tested: boot0 records the boot1 key
+/// manifest into the receipt slots on a first boot and compares against them on the next, so the
+/// "receipts match" path only appears across a reset.
+#[no_mangle]
+pub extern "C" fn emu_warm_reset(e: *mut Emulator) {
+    let e = unsafe { &mut *e };
+    let owc = e.mach.soc.owc; // one-way counters are non-volatile
+    let flash = core::mem::replace(&mut e.mach.soc.flash, bus::devices::spi_flash::SpiFlash::new());
+    e.mach.soc = bus::Soc::new();
+    e.mach.soc.owc = owc;
+    e.mach.soc.flash = flash; // external SPI flash is non-volatile too (holds swap + the PDDB)
+    // clear volatile RAM; keep RRAM (0x6000_0000) and the IFR fuse block (0x6040_0000)
+    for r in &mut e.mach.regions {
+        if r.base != 0x6000_0000 && r.base != 0x6040_0000 {
+            r.data.iter_mut().for_each(|b| *b = 0);
+        }
+    }
+    e.mach.cur_pc = 0;
+    e.mach.satp = 0;
+    e.mach.invalidate_code();
+    e.cpu = Cpu::new(0x6000_0000);
+    e.kick1_dumped = false;
+}

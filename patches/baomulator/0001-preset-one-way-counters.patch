+/// Preset a one-way counter before the first instruction, the same way
+/// `emu_set_pin` straps the badge type. Real firmware can only increment
+/// these; this reaches around that so a host can model a badge that has
+/// already crossed a one-way door (e.g. slot 85 `DEVELOPER_MODE`, which
+/// `boot1` sets on real hardware but which this emulator never runs).
+/// Out-of-range slots are ignored.
+#[no_mangle]
+pub extern "C" fn emu_set_owc(e: *mut Emulator, slot: u32, value: u32) {
+    let e = unsafe { &mut *e };
+    if let Some(c) = e.mach.soc.owc.get_mut(slot as usize) {
+        *c = value;
+    }
+}
+
+/// Current value of a one-way counter, or 0 for out-of-range slots.
+#[no_mangle]
+pub extern "C" fn emu_get_owc(e: *mut Emulator, slot: u32) -> u32 {
+    let e = unsafe { &*e };
+    e.mach.soc.owc.get(slot as usize).copied().unwrap_or(0)
+}

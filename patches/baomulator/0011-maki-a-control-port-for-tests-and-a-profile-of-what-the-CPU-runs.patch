+/// `--usb PORT`'s fourth port, PORT+3: a test's commands, one a line, each answered with a line
+/// (or, for `screen`, lines and then "end"):
+///
+///   press N [D]   press button N, for D instructions (20M if not given): "ok"; N+M+…
+///                 presses those together (left and right: maki's menu)
+///   shot NAME     the screen now, into OUT/NAME.pgm: "shot PATH"
+///   screen        the screen now, as text
+///   profile L S   from now, for L instructions, which process runs (satp's ASID, which Xous
+///                 makes the PID), whether the CPU is waiting (WFI) and where, every S
+///                 instructions: "profile PATH" once done, the samples in OUT/profile-*.txt
+///   quit          stop here, as if the last checkpoint had come
+struct Control {
+    listener: std::net::TcpListener,
+    client: Option<std::net::TcpStream>,
+    line: Vec<u8>,
+}
+
+enum Command {
+    Press(Vec<u32>, u64),
+    Shot(String),
+    Screen,
+    Profile(u64, u64),
+    Quit,
+}
+
+/// `N` or `N+M+…`: buttons to press together.
+fn buttons(spec: &str) -> Option<Vec<u32>> {
+    spec.split('+').map(|n| n.parse().ok().filter(|&n: &u32| (n as usize) < BUTTON_NAMES.len())).collect()
+}
+
+impl Control {
+    fn bind(port: u16) -> std::io::Result<Control> {
+        let listener = std::net::TcpListener::bind(("127.0.0.1", port))?;
+        listener.set_nonblocking(true)?;
+        Ok(Control { listener, client: None, line: Vec::new() })
+    }
+
+    /// The commands that came since.
+    fn poll(&mut self, total: u64) -> Vec<Command> {
+        use std::io::{ErrorKind, Read};
+        if self.client.is_none() {
+            if let Ok((stream, peer)) = self.listener.accept() {
+                stream.set_nonblocking(true).ok();
+                stream.set_nodelay(true).ok();
+                println!("[{total:>13}] control: connected from {peer}");
+                self.client = Some(stream);
+                self.line.clear();
+            }
+        }
+        let mut commands = Vec::new();
+        let Some(stream) = self.client.as_mut() else { return commands };
+        let mut buf = [0u8; 1024];
+        loop {
+            match stream.read(&mut buf) {
+                Ok(0) => {
+                    println!("[{total:>13}] control: disconnected");
+                    self.client = None;
+                    break;
+                }
+                Ok(n) => self.line.extend_from_slice(&buf[..n]),
+                Err(err) if err.kind() == ErrorKind::Interrupted => continue,
+                Err(_) => break,
+            }
+        }
+        while let Some(end) = self.line.iter().position(|&b| b == b'\n') {
+            let line: Vec<u8> = self.line.drain(..=end).collect();
+            let line = String::from_utf8_lossy(&line).trim().to_string();
+            let words: Vec<&str> = line.split_whitespace().collect();
+            let command = match words.as_slice() {
+                ["press", n] => buttons(n).map(|n| Command::Press(n, 20_000_000)),
+                ["press", n, d] => buttons(n).zip(parse_count(d)).map(|(n, d)| Command::Press(n, d)),
+                ["shot", name] if name.chars().all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_') => {
+                    Some(Command::Shot(name.to_string()))
+                }
+                ["screen"] => Some(Command::Screen),
+                ["profile", l, s] => parse_count(l).zip(parse_count(s)).filter(|(_, s)| *s > 0).map(|(l, s)| Command::Profile(l, s)),
+                ["quit"] => Some(Command::Quit),
+                [] => continue,
+                _ => None,
+            };
+            match command {
+                Some(c) => commands.push(c),
+                None => self.reply(&format!("error: {line:?}?")),
+            }
+        }
+        commands
+    }
+
+    fn reply(&mut self, text: &str) {
+        use std::io::Write;
+        if let Some(stream) = self.client.as_mut() {
+            // a short answer: blocking for it is fine
+            stream.set_nonblocking(false).ok();
+            if stream.write_all(format!("{text}\n").as_bytes()).is_err() {
+                self.client = None;
+                return;
+            }
+            stream.set_nonblocking(true).ok();
+        }
+    }
+}
+
 /// A HID keyboard usage as text (US layout), or a name in brackets for keys that aren't text.
 fn usage_text(code: u8, shift: bool) -> Option<String> {
     const LOWER: &[u8] = b"abcdefghijklmnopqrstuvwxyz1234567890";

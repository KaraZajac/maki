@@ -706,12 +827,74 @@ fn main() {
             let chunk = SLICE
                 .min(at - total)
                 .min(next_sample.saturating_sub(total).max(1))
-                .min(rpt_at.saturating_sub(total).max(1));
+                .min(rpt_at.saturating_sub(total).max(1))
+                .min(profile.as_ref().map_or(u64::MAX, |p| p.2.saturating_sub(total).max(1)));
             baomulator::emu_run(e, chunk as u32, 10);
             total += chunk;
             if let Some(pipe) = usb.as_mut() {
                 pipe.pump(e, total);
             }
+            if let Some(ctl) = control.as_mut() {
+                for command in ctl.poll(total) {
+                    match command {
+                        Command::Press(btns, dur) => {
+                            for btn in btns {
+                                events.push(Reverse((total + 1, Kind::Press, btn)));
+                                events.push(Reverse((total + 1 + dur, Kind::Release, btn)));
+                            }
+                            ctl.reply("ok");
+                        }
+                        Command::Shot(name) => {
+                            let f = capture(e, total);
+                            let path = format!("{}/{name}.pgm", a.out_dir);
+                            match write_pgm(&path, &f.fb) {
+                                Ok(()) => ctl.reply(&format!("shot {path}")),
+                                Err(err) => ctl.reply(&format!("error: {err}")),
+                            }
+                        }
+                        Command::Screen => {
+                            let f = capture(e, total);
+                            ctl.reply(&format!("{}\nend", ascii_art(&f.fb, true).trim_end()));
+                        }
+                        Command::Profile(len, step) => {
+                            profile = Some((total + len, step, total, String::new()));
+                        }
+                        Command::Quit => {
+                            ctl.reply("ok");
+                            quit = true;
+                        }
+                    }
+                }
+                if quit || events.peek().is_some_and(|Reverse((next, _, _))| *next < at) {
+                    sooner = !quit;
+                    break;
+                }
+            }
+            if let Some((to, step, next, out)) = profile.as_mut() {
+                if total >= *next && total < *to {
+                    let satp = baomulator::emu_dbg_csr(e, 0x180);
+                    out.push_str(&format!(
+                        "{} {} {} {} {:08x}\n",
+                        total,
+                        (satp >> 22) & 0x1ff,
+                        baomulator::emu_dbg_prv(e),
+                        baomulator::emu_dbg_wfi(e) as u8,
+                        baomulator::emu_dbg_pc(e)
+                    ));
+                    *next = total + *step;
+                }
+                if total >= *to {
+                    let path = format!("{}/profile-{total}.txt", a.out_dir);
+                    let written = std::fs::write(&path, out.as_bytes());
+                    if let Some(ctl) = control.as_mut() {
+                        match written {
+                            Ok(()) => ctl.reply(&format!("profile {path}")),
+                            Err(err) => ctl.reply(&format!("error: {err}")),
+                        }
+                    }
+                    profile = None;
+                }
+            }
             if a.realtime && total >= a.realtime_from && paced.is_none() {
                 paced = Some((std::time::Instant::now(), baomulator::emu_time_ns(e)));
                 println!("[{total:>13}] realtime from here");
@@ -794,8 +977,11 @@ fn main() {
                 }
             }
         }
+        if quit {
+            break;
+        }
         if sooner {
-            // an answer comes first: this waits its turn
+            // an answer (or a test's press) comes first: this waits its turn
             events.push(Reverse((at, kind, btn)));
             continue;
         }

 //!   --realtime        never let maki's time run ahead of this computer's: asleep, it waits
 //!                     for the clock (and wakes for the host's bytes) rather than skipping to
 //!                     its next timer, so a host's timing (heartbeats, timeouts) holds. Counts
@@ -256,6 +257,8 @@ enum Command {
     Profile(u64, u64),
     /// a picture for the camera (a PGM's path), or none: the built-in test QR again
     Camera(Option<String>),
+    /// the swapper's page table now, into OUT/rpt-NAME.txt
+    PageTable(String),

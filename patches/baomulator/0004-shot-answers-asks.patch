+/// Reads maki's console as it grows, a line at a time, for `--answer`.
+#[derive(Default)]
+struct ConsoleLines {
+    /// how many bytes ever written have been read
+    read: u64,
+    partial: Vec<u8>,
+}
+
+impl ConsoleLines {
+    /// The whole lines written since the last call.
+    fn new_lines(&mut self, e: *mut Emulator) -> Vec<String> {
+        let len = baomulator::emu_console_len(e);
+        let bytes = unsafe { std::slice::from_raw_parts(baomulator::emu_console_ptr(e), len) };
+        let dropped = baomulator::emu_console_dropped(e);
+        // what was trimmed before it was read is gone
+        let from = self.read.saturating_sub(dropped).min(len as u64) as usize;
+        self.read = dropped + len as u64;
+        self.partial.extend_from_slice(&bytes[from..]);
+        let mut lines = Vec::new();
+        while let Some(end) = self.partial.iter().position(|&b| b == b'\n') {
+            let line: Vec<u8> = self.partial.drain(..=end).collect();
+            lines.push(String::from_utf8_lossy(&line).trim_end().to_string());
+        }
+        lines
+    }
+}

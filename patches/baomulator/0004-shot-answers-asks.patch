+/// How many bytes of console output have been trimmed off the front of the buffer: the byte at
+/// index `i` of `emu_console_ptr` is the `emu_console_dropped() + i`th ever written.
+#[no_mangle]
+pub extern "C" fn emu_console_dropped(e: *mut Emulator) -> u64 {
+    unsafe { &*e }.console_dropped

index 42992dc..14dbe6b 100644
--- a/src/bus/soc.rs
+++ b/src/bus/soc.rs
@@ -10,6 +10,8 @@ pub struct Soc {
     pub ticktimer: TickTimer,
     pub timer0: Timer0,
     pub d11ctime: D11cTime,
+    /// maki: the PL031 RTC, which maki's clock runs on
+    pub rtc: Rtc,
     pub irqarray: [IrqArray; 20],
     pub duart: Duart,
     pub trng: Trng,
@@ -110,6 +112,7 @@ pub const ONEWAY_STRIDE: u32 = 32;
 pub const TICKTIMER_BASE: u32 = 0xe001_b000;
 pub const TIMER0_BASE: u32 = 0xe001_c000;
 pub const D11CTIME_BASE: u32 = 0xe000_0000;
+pub const RTC_BASE: u32 = 0x4006_1000;
 pub const IRQARRAY_BASE: u32 = 0xe000_4000;
 pub const DUART_BASE: u32 = 0x4004_2000;
 pub const TRNG_BASE: u32 = 0x4002_e000;
@@ -146,6 +149,7 @@ impl Soc {
             ticktimer: TickTimer::new(),
             timer0: Timer0::new(),
             d11ctime: D11cTime::new(),
+            rtc: Rtc::new(),
             irqarray: core::array::from_fn(|_| IrqArray::new()),
             duart: Duart::new(),
             trng: Trng::new(),
@@ -334,6 +338,7 @@ impl Soc {
             a if a >= D11CTIME_BASE && a < D11CTIME_BASE + 0x1000 => {
                 self.d11ctime.read(a - D11CTIME_BASE)
             }
+            a if a >= RTC_BASE && a < RTC_BASE + 0x1000 => self.rtc.read(a - RTC_BASE, self.settled_ns),
             a if a >= IRQARRAY_BASE && a < IRQARRAY_BASE + 20 * 0x1000 => {
                 self.irqarray[((a - IRQARRAY_BASE) / 0x1000) as usize].read((a - IRQARRAY_BASE) % 0x1000)
             }
@@ -415,6 +420,9 @@ impl Soc {
             a if a >= D11CTIME_BASE && a < D11CTIME_BASE + 0x1000 => {
                 self.d11ctime.write(a - D11CTIME_BASE, val)
             }
+            a if a >= RTC_BASE && a < RTC_BASE + 0x1000 => {
+                self.rtc.write(a - RTC_BASE, val, self.settled_ns)
+            }
             a if a >= IRQARRAY_BASE && a < IRQARRAY_BASE + 20 * 0x1000 => {
                 self.irqarray[((a - IRQARRAY_BASE) / 0x1000) as usize]
                     .write((a - IRQARRAY_BASE) % 0x1000, val)
